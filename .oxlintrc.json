{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "jsPlugins": ["@shadcn/lint"],
  "settings": {
    "shadcn": {
      "ui": "@/components"
    }
  },
  "plugins": ["react", "unicorn", "typescript", "nextjs"],
  "rules": {
    "no-unused-vars": "off",
    "typescript/no-unused-vars": ["warn", { "argsIgnorePattern": "^_" }],
    "typescript/no-explicit-any": "warn",
    "react/jsx-key": "error",
    "react/no-unknown-property": "error",
    "react-hooks/rules-of-hooks": "error",
    "react-hooks/exhaustive-deps": "warn",
    "shadcn/no-unknown-classes": "error",
    "shadcn/require-static-classes": "error",
    "shadcn/no-raw-colors": "error",
    "shadcn/no-inline-styles": ["error", { "allow": ["backgroundImage"] }],
    "shadcn/no-restyle": [
      "error",
      {
        "allow": ["layout"],
        "contracts": [
          {
            "pattern": "^ShimmerBlock$",
            "allow": ["layout", "shape"]
          },
          {
            "pattern": "^AssetCategoryIcon$",
            "allow": ["layout", "color"]
          },
          {
            "pattern": "^Input$",
            "allow": ["layout", "font-mono", "text-xs"]
          }
        ]
      }
    ],
    "shadcn/no-arbitrary-values": [
      "error",
      {
        "allow": [
          "layout",
          "border-[length:var(--bw-default)]",
          "border-[length:var(--bw-strong)]",
          "border-b-[length:var(--bw-strong)]",
          "border-t-[length:var(--bw-strong)]"
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": ["apps/api/**"],
      "rules": {
        "shadcn/no-unknown-classes": "off",
        "shadcn/require-static-classes": "off",
        "shadcn/no-raw-colors": "off",
        "shadcn/no-inline-styles": "off",
        "shadcn/no-restyle": "off",
        "shadcn/no-arbitrary-values": "off"
      }
    },
    {
      "files": ["apps/web/src/components/**", "apps/web/src/lib/field-styles.ts"],
      "rules": {
        "shadcn/no-unknown-classes": "off",
        "shadcn/require-static-classes": "off",
        "shadcn/no-raw-colors": "off",
        "shadcn/no-inline-styles": "off",
        "shadcn/no-restyle": "off",
        "shadcn/no-arbitrary-values": "off"
      }
    }
  ],
  "ignorePatterns": [
    "**/dist/**",
    "**/.next/**",
    "**/out/**",
    "**/build/**",
    "**/node_modules/**",
    "mobile/**",
    "**/*.d.ts"
  ]
}
