{
  "name": "pg-management",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --cwd apps/api dev & bun run --cwd apps/web dev & wait",
    "build": "bun --filter '*' build",
    "lint": "oxlint",
    "typecheck": "bun --filter '*' typecheck",
    "test": "bun --filter '@pg/api' test",
    "test:unit": "bun --filter '@pg/api' test && bun --filter '@pg/web' test:unit",
    "test:e2e": "bun --filter '@pg/web' test:e2e",
    "clean": "bun --filter '*' clean",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:contracts": "bun scripts/audit/check-contracts.ts",
    "check:layout": "bun scripts/audit/check-layout-frame.mjs",
    "check:type-scale": "bun scripts/audit/check-type-scale.ts",
    "gen:lifecycle": "bun scripts/audit/gen-lifecycle-dart.ts",
    "check:lifecycle": "bun scripts/audit/check-lifecycle-parity.ts",
    "seed": "bun --filter '@pg/api' seed",
    "seed:sample": "bun --filter '@pg/api' seed -- --with-sample-data",
    "seed:dashboard": "bun --filter '@pg/api' seed:dashboard",
    "seo": "bun scripts/generate-seo-files.ts",
    "mobile:setup": "cd mobile && flutter pub get",
    "mobile:gen": "cd mobile && dart run build_runner build --delete-conflicting-outputs"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devDependencies": {
    "@shadcn/lint": "0.2.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxlint": "1.93.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "7.0.2"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "overrides": {
    "source-map-js": "^1.2.2",
    "follow-redirects": "^1.16.3",
    "fast-copy": "^2.2.0",
    "sharp": "^0.35.5",
    "baseline-browser-mapping": "^2.11.35",
    "tinypool": "^2.2.0",
    "nanoid": "^5.1.16",
    "postcss": "^8.5.32",
    "@vitest/mocker": "^5.1.0",
    "vite": "^8.3.8",
    "hono": "^4.13.18",
    "esbuild": "^0.28.2",
    "next": "^16.4.6",
    "mongoose": "^9.12.1"
  }
}
