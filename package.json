{
  "name": "pg-management",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --cwd apps/api dev & bun run --cwd apps/web dev & wait",
    "build": "bun --filter '*' build",
    "lint": "oxlint",
    "typecheck": "bun --filter '*' typecheck",
    "test": "bun --filter '@pg/api' test",
    "test:unit": "bun --filter '@pg/api' test && bun --filter '@pg/web' test:unit",
    "test:e2e": "bun --filter '@pg/web' test:e2e",
    "clean": "bun --filter '*' clean",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "seed": "bun --filter '@pg/api' seed",
    "seed:sample": "bun --filter '@pg/api' seed -- --with-sample-data",
    "seed:dashboard": "bun --filter '@pg/api' seed:dashboard",
    "seo": "bun scripts/generate-seo-files.ts",
    "mobile:setup": "cd mobile && flutter pub get",
    "mobile:gen": "cd mobile && dart run build_runner build --delete-conflicting-outputs"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devDependencies": {
    "@shadcn/lint": "0.2.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "oxlint": "1.85.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "7.0.2"
  },
  "engines": {
    "bun": ">=1.3.0"
  }
}
