{
  "name": "@pg/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "build": "bun build src/index.ts --outdir=dist --target=bun",
    "start": "bun run dist/index.js",
    "lint": "oxlint src/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed": "bun run src/scripts/seed.ts",
    "seed:dashboard": "bun run src/scripts/seed-dashboard-telemetry.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.9.1",
    "@pg/types": "workspace:*",
    "@react-pdf/renderer": "^4.9.0",
    "bcryptjs": "^2.4.3",
    "chroma-js": "^3.3.0",
    "cloudinary": "^2.11.0",
    "hono": "^4.13.18",
    "jose": "^6.2.17",
    "mongoose": "^9.12.1",
    "node-cron": "^3.0.3",
    "pino": "^9.14.0",
    "pino-pretty": "^11.3.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "resend": "^4.8.0",
    "uuid": "^11.1.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/bun": "1.4.4",
    "@types/chroma-js": "3.1.3",
    "@types/mongoose": "^5.11.97",
    "@types/node-cron": "^3.0.11",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.3.0",
    "@types/uuid": "^11.0.0",
    "mongodb-memory-server": "11.3.0",
    "typescript": "^7.0.0",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "source-map-js": "^1.2.2",
    "follow-redirects": "^1.16.3",
    "fast-copy": "^2.2.0",
    "sharp": "^0.35.5",
    "baseline-browser-mapping": "^2.11.35",
    "tinypool": "^2.2.0",
    "nanoid": "^5.1.16",
    "postcss": "^8.5.32",
    "@vitest/mocker": "^5.1.0",
    "vite": "^8.3.8",
    "esbuild": "^0.28.2",
    "next": "^16.4.6"
  }
}
