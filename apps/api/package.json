{
  "name": "@pg/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "build": "bun build src/index.ts --outdir=dist --target=bun",
    "start": "bun run dist/index.js",
    "lint": "oxlint src/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed": "bun run src/scripts/seed.ts",
    "seed:dashboard": "bun run src/scripts/seed-dashboard-telemetry.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.4.0",
    "@pg/types": "workspace:*",
    "@react-pdf/renderer": "^4.5.0",
    "bcryptjs": "^2.4.3",
    "chroma-js": "^3.1.0",
    "cloudinary": "^2.5.0",
    "hono": "^4.13.14",
    "jose": "^6.0.0",
    "mongoose": "^9.11.4",
    "node-cron": "^3.0.3",
    "pino": "^9.6.0",
    "pino-pretty": "^11.3.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "resend": "^4.2.0",
    "uuid": "^11.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/bun": "1.3.14",
    "@types/chroma-js": "3.1.2",
    "@types/mongoose": "^5.11.97",
    "@types/node-cron": "^3.0.11",
    "@types/qrcode": "^1.5.5",
    "@types/react": "19.2.17",
    "@types/uuid": "^10.0.0",
    "mongodb-memory-server": "11.2.0",
    "typescript": "^7.0.0",
    "vitest": "^3.0.0"
  },
  "overrides": {
    "source-map-js": "^1.2.2",
    "follow-redirects": "^1.16.1",
    "fast-copy": "^2.2.0",
    "sharp": "^0.35.5",
    "baseline-browser-mapping": "^2.11.0",
    "tinypool": "^2.1.2",
    "nanoid": "^5.1.16",
    "postcss": "^8.5.23",
    "@vitest/mocker": "^5.0.3",
    "vite": "^8.2.4",
    "esbuild": "^0.28.1",
    "next": "^16.4.3"
  }
}
